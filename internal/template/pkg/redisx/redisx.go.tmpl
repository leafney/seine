package redisx

import (
	"context"
	"time"

	"{{.ModulePath}}/config"
	"{{.ModulePath}}/pkg/zlogx"
	"github.com/go-redis/redis/v8"
)

// RedisSvc Redis服务
type RedisSvc struct {
	client *redis.Client
	log    *zlogx.ZLogSvc
	stop   chan struct{}
}

// NewRedisSvc 创建Redis服务
func NewRedisSvc(cfg *config.Config, log *zlogx.ZLogSvc, stop chan struct{}) *RedisSvc {
	redisCfg := cfg.Redis
	if !redisCfg.Enable {
		log.Info("Redis服务未启用")
		return &RedisSvc{
			client: nil,
			log:    log,
			stop:   stop,
		}
	}

	client := redis.NewClient(&redis.Options{
		Addr:     redisCfg.Addr,
		Password: redisCfg.Password,
		DB:       redisCfg.DB,
	})

	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	_, err := client.Ping(ctx).Result()
	if err != nil {
		log.Error("Redis连接失败", zap.Error(err))
		return &RedisSvc{
			client: nil,
			log:    log,
			stop:   stop,
		}
	}

	log.Info("Redis连接成功")
	return &RedisSvc{
		client: client,
		log:    log,
		stop:   stop,
	}
}

// Close 关闭Redis连接
func (s *RedisSvc) Close() {
	if s.client != nil {
		err := s.client.Close()
		if err != nil {
			s.log.Error("关闭Redis连接失败", zap.Error(err))
		}
	}
}

// Client 获取Redis客户端
func (s *RedisSvc) Client() *redis.Client {
	return s.client
}

// Set 设置键值对
func (s *RedisSvc) Set(ctx context.Context, key string, value interface{}, expiration time.Duration) error {
	if s.client == nil {
		return nil
	}
	return s.client.Set(ctx, key, value, expiration).Err()
}

// Get 获取值
func (s *RedisSvc) Get(ctx context.Context, key string) (string, error) {
	if s.client == nil {
		return "", nil
	}
	return s.client.Get(ctx, key).Result()
}

// Del 删除键
func (s *RedisSvc) Del(ctx context.Context, keys ...string) error {
	if s.client == nil {
		return nil
	}
	return s.client.Del(ctx, keys...).Err()
}

// Exists 检查键是否存在
func (s *RedisSvc) Exists(ctx context.Context, keys ...string) (int64, error) {
	if s.client == nil {
		return 0, nil
	}
	return s.client.Exists(ctx, keys...).Result()
}
